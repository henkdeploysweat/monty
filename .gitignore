# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/

# CDK
infra/cdk.out/
infra/.cdk.staging/
*.swp

# Editor
.idea/
.vscode/
.DS_Store

# Local secrets / env files — never commit
.env
.env.*
!.env.example

# Build artifact: the ECR digest captured by `make build` and consumed by
# `make cdk-deploy`. Ephemeral per checkout — a committed (stale) digest
# would silently deploy the WRONG image.
.image-digest

# Local RAG index (SQLite + its -wal/-shm sidecars). Regenerable local
# state that churns on every run and conflicts on merge — never commit.
.rag/
